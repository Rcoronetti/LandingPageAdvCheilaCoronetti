@using CheilaCoronetti.Web.Data

<section class="section section-alt" id="areas">
    <div class="container">
        <SectionHeader Eyebrow="Áreas de atuação"
                       Title="Especialização que faz a diferença"
                       Subtitle="Atuação completa junto ao INSS e ao CRPS, com estratégia definida caso a caso." />

        <div class="areas-grid">
            @for (var i = 0; i < AreasAtuacaoData.Todas.Length; i++)
            {
                var area = AreasAtuacaoData.Todas[i];
                <article class="area-card" data-reveal>
                    <span class="area-icon">
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor"
                             stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            @((MarkupString)Icones.Svgs[i])
                        </svg>
                    </span>
                    <h3>@area.Titulo</h3>
                    <p>@area.Descricao</p>
                </article>
            }
        </div>
    </div>
</section>