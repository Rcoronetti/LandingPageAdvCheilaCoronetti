@using CheilaCoronetti.Web.Data

<section class="section section-alt" id="escritorio">
    <div class="container escritorio-grid">
        <div class="escritorio-media" data-reveal>
            <img src="img/escritorio.jpeg"
                 alt="Escritório Cheila Coronetti" loading="lazy" />
        </div>
        <div class="escritorio-text" data-reveal>
            <p class="eyebrow">O escritório</p>
            <h2>Você é atendido pela advogada que cuida do seu caso</h2>
            <p>
                O escritório fica no centro de Ponte Serrada, na rua @EscritorioInfo.Endereco.
                Quem vem até aqui conversa direto com a Dra. Cheila — e quem prefere resolver de casa
                é atendido pelo WhatsApp do mesmo jeito.
            </p>
            <WhatsAppButton Label="Falar no WhatsApp" />
        </div>
    </div>
</section>