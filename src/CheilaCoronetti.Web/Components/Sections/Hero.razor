@using CheilaCoronetti.Web.Data

<section class="hero" id="inicio">
    <div class="container hero-inner">
        <div class="hero-content" data-reveal>
            <img class="hero-logo" src="img/logo.png"
                 alt="Cheila Coronetti Advogada — Direito Previdenciário"
                 width="200" height="200" />

            <p class="eyebrow">Advocacia Previdenciária · Ponte Serrada/SC</p>
            <h1>Direito Previdenciário com quem <em>entende de benefício</em></h1>
            <p class="hero-sub">
                A Dra. Cheila Coronetti atua há mais de @EscritorioInfo.AnosAtuacao anos em aposentadorias,
                revisões e auxílios junto ao INSS e ao CRPS — com atendimento próximo, claro e transparente
                em cada etapa do seu processo.
            </p>
            <div class="hero-actions">
                <WhatsAppButton Label="Falar no WhatsApp" Large="true" />
                <a class="btn btn-ghost" href="#areas">Conhecer as áreas</a>
            </div>
            <ul class="hero-badges">
                <li>@EscritorioInfo.AnosAtuacao+ anos de atuação</li>
                <li>Especialista em INSS e CRPS</li>
                <li>Atendimento humanizado</li>
            </ul>
        </div>

        <div class="hero-media" data-reveal>
            <img src="https://placehold.co/640x800/12263A/B08D57?text=Dra.+Cheila+Coronetti"
                 alt="Foto da Dra. Cheila Coronetti" width="640" height="800" />
            <div class="hero-card">
                <strong>+@EscritorioInfo.AnosAtuacao anos</strong>
                <span>defendendo direitos previdenciários</span>
            </div>
        </div>
    </div>
</section>